# --- Oh My Zsh ---
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="agnoster"

plugins=(git zsh-autosuggestions)
source "$ZSH/oh-my-zsh.sh"

# Override agnoster segments for brighter, higher-contrast colors
prompt_context() {
  if [[ "$USERNAME" != "$DEFAULT_USER" || -n "$SSH_CLIENT" ]]; then
    prompt_segment 48 black "%(!.%{%F{yellow}%}.)%n@%m"  # bright green
  fi
}

prompt_dir() {
  prompt_segment 39 black '%~'  # bright cyan/blue
}

prompt_git() {
  (( $+commands[git] )) || return
  if [[ "$(git config --get oh-my-zsh.hide-status 2>/dev/null)" = 1 ]]; then
    return
  fi
  local PL_BRANCH_CHAR=$'\ue0a0'  #
  local ref dirty mode repo_path
  if [[ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" = "true" ]]; then
    repo_path=$(git rev-parse --git-dir 2>/dev/null)
    dirty=$(parse_git_dirty)
    ref=$(git symbolic-ref HEAD 2>/dev/null) || ref="$(git rev-parse --short HEAD 2>/dev/null)"
    if [[ -n $dirty ]]; then
      prompt_segment 220 black  # bright yellow for dirty
    else
      prompt_segment 118 black  # bright green for clean
    fi
    echo -n "${ref/refs\/heads\//$PL_BRANCH_CHAR }${dirty}"
  fi
}

# --- Editor ---
export EDITOR="zed --wait"
export VISUAL="zed --wait"

# --- Secrets (never committed) ---
if [ -f "$HOME/.secrets" ]; then
  . "$HOME/.secrets"
fi

# --- Build environment ---
export OPENSSL_ROOT_DIR="/opt/homebrew/opt/openssl@3"
export OPENSSL_LIB_DIR="/opt/homebrew/opt/openssl@3/lib"
export OPENSSL_INCLUDE_DIR="/opt/homebrew/opt/openssl@3/include"
export PKG_CONFIG_PATH="/opt/homebrew/opt/openssl@3/lib/pkgconfig"
export CPPFLAGS="-I/opt/homebrew/opt/openssl/include"
export LDFLAGS="-L/opt/homebrew/opt/openssl/lib"

# --- Language/tool managers ---

# rbenv
export PATH="$HOME/.rbenv/bin:$PATH"
eval "$(rbenv init -)"

# NVM
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && . "/opt/homebrew/opt/nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && . "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# SDKMAN (must be near end for it to work)
export SDKMAN_DIR="$HOME/.sdkman"
[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ] && source "$HOME/.sdkman/bin/sdkman-init.sh"

# direnv
eval "$(direnv hook zsh)"

# Atuin
. "$HOME/.atuin/bin/env"
eval "$(atuin init zsh)"

# --- PATH additions ---

export PATH="/opt/homebrew/opt/llvm/bin:$PATH"
export PATH="$PATH:$HOME/.local/bin"

# Go
if [ -d "$HOME/go/bin" ]; then
  export PATH="$HOME/go/bin:$PATH"
fi

# Dotfiles exports
if [ -f "$HOME/.dotfiles/zsh/.bash_exports" ]; then
  . "$HOME/.dotfiles/zsh/.bash_exports"
fi

# --- Shell utilities ---

# Play sound on command failure
play_on_error() {
  local EXIT_CODE=$?
  if [ $EXIT_CODE -ne 0 ]; then
    (afplay ~/Downloads/ooof.m4a > /dev/null 2>&1 &)
  fi
  return $EXIT_CODE
}
precmd_functions+=(play_on_error)

listening() {
  if [ $# -eq 0 ]; then
    sudo lsof -iTCP -sTCP:LISTEN -n -P
  elif [ $# -eq 1 ]; then
    sudo lsof -iTCP -sTCP:LISTEN -n -P | grep -i --color "$1"
  else
    echo "Usage: listening [pattern]"
  fi
}

killpid() {
  if [ $# -eq 1 ]; then
    kill -9 "$1"
  else
    kill
  fi
}

# --- Aliases ---
alias fucking=sudo
alias wow="git status"
alias very=git
alias such=git
alias much=git
alias so=git
alias p="pnpm"

# --- Aliases and completions ---
source "$HOME/.dotfiles/zsh/aliases.zsh"
source "$HOME/.dotfiles/zsh/claude-completion.zsh"
source "$HOME/.dotfiles/zsh/gt-completion.zsh"

# --- Greeting ---
if command -v fortune >/dev/null 2>&1 && command -v cowsay >/dev/null 2>&1 && [ -z "$GREETING_SHOWN" ]; then
  fortune -n 320 -s | cowsay -f small
  export GREETING_SHOWN=1
fi


# --- Syntax highlighting (must be near end) ---
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
